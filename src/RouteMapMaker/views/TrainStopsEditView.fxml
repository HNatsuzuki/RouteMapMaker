<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="300.0" maxWidth="600.0" minHeight="300.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.65" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RouteMapMaker.controllers.TrainStopsEditController">
   <children>
      <fx:define>
         <ToggleGroup fx:id="group" />
      </fx:define>
      <ListView fx:id="stationListView" layoutX="198.0" layoutY="36.0" prefHeight="200.0" prefWidth="156.0" />
      <ListView fx:id="trainStopListView" layoutX="430.0" layoutY="36.0" prefHeight="200.0" prefWidth="156.0" />
      <Label layoutX="276.0" layoutY="14.0" text="駅" />
      <Label layoutX="489.0" layoutY="14.0" text="停車駅" />
      <Button fx:id="closeButton" layoutX="528.0" layoutY="259.0" mnemonicParsing="false" text="閉じる" />
      <ToggleButton fx:id="insertButton" layoutX="371.0" layoutY="50.0" mnemonicParsing="false" text="挿入" toggleGroup="$group" />
      <ToggleButton fx:id="deleteButton" layoutX="371.0" layoutY="99.0" mnemonicParsing="false" text="削除" toggleGroup="$group" />
      <ToggleButton fx:id="insertAllButton" layoutX="365.0" layoutY="150.0" mnemonicParsing="false" text="全追加" toggleGroup="$group" />
      <ToggleButton fx:id="deleteAllButton" layoutX="365.0" layoutY="199.0" mnemonicParsing="false" text="全削除" toggleGroup="$group" />
      <Label fx:id="infoLabel" layoutX="14.0" layoutY="50.0" text="停車駅は駅一覧の中から上から" />
   </children>
</AnchorPane>
